{
  "name": "saas-platform-foundation",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "dotenv -e .env -- turbo run build",
    "dev": "dotenv -e .env -- turbo run dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm --filter @saas/api test",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "db:generate": "dotenv -e .env -- turbo run db:generate",
    "db:migrate": "dotenv -e .env -- turbo run db:migrate",
    "db:seed": "dotenv -e .env -- turbo run db:seed",
    "db:reset": "dotenv -e .env -- turbo run db:reset",
    "db:push": "dotenv -e .env -- turbo run db:push",
    "clean": "turbo run clean && rimraf node_modules",
    "lint:design": "node scripts/check-design.js",
    "lint:design:strict": "node scripts/check-design.js --strict",
    "db:check-limits": "node scripts/check-column-limits.js --strict",
    "security:tenant-scope": "node scripts/check-tenant-scope.js",
    "security:tenant-scope:strict": "node scripts/check-tenant-scope.js --strict",
    "security:audit": "pnpm audit --audit-level=high",
    "security:check": "pnpm run security:audit && pnpm run security:tenant-scope",
    "test:smoke": "node scripts/smoke-crawl.mjs"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.4.2",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "7.1.1",
    "playwright": "1.64.1",
    "prettier": "^3.9.10",
    "rimraf": "^5.0.5",
    "turbo": "^2.11.9"
  },
  "packageManager": "pnpm@9.1.0",
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.18",
      "proxy-addr": "^2.0.8",
      "websocket-driver": "^0.7.5",
      "multer": "^2.2.0",
      "ws@>=8 <9": "^8.21.0",
      "socket.io-parser": "^4.2.7",
      "engine.io": "^6.6.10",
      "compression": "^1.8.2",
      "axios": "^1.20.0",
      "follow-redirects": "^1.16.1",
      "form-data@>=4 <5": "^4.0.6",
      "form-data@<3": "^2.5.6",
      "protobufjs@>=7 <8": "^7.6.1",
      "@grpc/grpc-js": "^1.14.4",
      "brace-expansion@<2": "^1.1.16",
      "lodash": "^4.18.1",
      "js-yaml@>=4 <5": "^4.3.0",
      "postcss": "^8.5.12",
      "nanoid@<4": "^3.3.18",
      "browserslist": "^4.28.7",
      "source-map-js": "^1.2.2",
      "@fastify/busboy": "^3.2.1",
      "sharp": "^0.35.5"
    }
  }
}
