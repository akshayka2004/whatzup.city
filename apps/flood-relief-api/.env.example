NODE_ENV=development
PORT=4002

# Own dedicated Postgres database — never the shared Supabase DATABASE_URL used by
# apps/api / apps/web / apps/worker. Self-hosted on the VPS or a separate managed
# instance; either way, keep it isolated from the rest of the monorepo.
DATABASE_URL="postgresql://kfr_user:kfr_password@localhost:5432/kerala_flood_relief?schema=public"

# Own secret — never reuse the SaaS platform's JWT_SECRET.
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

# Local dev: the flood-relief-web Vite dev server. Production: https://floodrelief.<DOMAIN>
CORS_ORIGIN=http://localhost:5173

SEED_ADMIN_NAME="Portal Administrator"
SEED_ADMIN_EMAIL=admin@keralafloodrelief.gov.in
SEED_ADMIN_PASSWORD=ChangeMe@12345
